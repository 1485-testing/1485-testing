<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>관리자 | 스마트디자인</title>
  <meta name="robots" content="noindex,nofollow"/>
  <style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{--p:#1e3a5f;--a:#e53030;--bg:#f0f4f8;--card:#fff;--tx:#111827;--mu:#6b7280;--bd:#e5e7eb;--sh:0 2px 8px rgba(0,0,0,.08)}
body{font-family:'Apple SD Gothic Neo','Malgun Gothic',sans-serif;background:var(--bg);color:var(--tx);font-size:14px;min-height:100vh}
a{color:inherit;text-decoration:none}

/* ── 헤더 ── */
.hd{background:var(--p);height:56px;display:flex;align-items:center;justify-content:space-between;padding:0 20px}
.hd-logo{font-size:18px;font-weight:900;color:#fff}
.hd-logo b{color:#ff7b7b}
.hd-home{color:rgba(255,255,255,.7);font-size:13px}

/* ── 로그인 ── */
#login-screen{display:flex;align-items:center;justify-content:center;min-height:calc(100vh - 56px);padding:20px}
.login-box{background:var(--card);border-radius:14px;padding:36px 28px;width:100%;max-width:360px;box-shadow:var(--sh);text-align:center}
.login-box h2{font-size:20px;font-weight:900;margin-bottom:6px}
.login-box p{font-size:13px;color:var(--mu);margin-bottom:24px}
.inp{width:100%;padding:12px 14px;border:1.5px solid var(--bd);border-radius:8px;font-size:14px;font-family:inherit;outline:none;margin-bottom:12px}
.inp:focus{border-color:var(--p)}
.btn-primary{width:100%;padding:13px;background:var(--p);color:#fff;border:none;border-radius:8px;font-size:15px;font-weight:700;cursor:pointer}
.btn-primary:hover{background:#163060}
.login-err{color:var(--a);font-size:13px;margin-top:8px;display:none}

/* ── 관리자 화면 ── */
#admin-screen{display:none}
.tabs{display:flex;background:var(--card);border-bottom:2px solid var(--bd);position:sticky;top:0;z-index:100}
.tab{flex:1;padding:14px 8px;text-align:center;font-size:13px;font-weight:700;color:var(--mu);border-bottom:2px solid transparent;margin-bottom:-2px;cursor:pointer;transition:.15s}
.tab.on{color:var(--p);border-bottom-color:var(--p)}
.tab-content{display:none;padding:20px 16px}
.tab-content.on{display:block}

/* ── 폼 ── */
.form-group{margin-bottom:14px}
.form-label{display:block;font-size:12px;font-weight:700;color:var(--mu);margin-bottom:6px}
.form-inp,.form-sel,.form-ta{width:100%;padding:11px 12px;border:1.5px solid var(--bd);border-radius:8px;font-size:14px;font-family:inherit;background:var(--bg);color:var(--tx);outline:none}
.form-inp:focus,.form-sel:focus,.form-ta:focus{border-color:var(--p);background:#fff}
.form-ta{min-height:90px;resize:vertical}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.btn-submit{width:100%;padding:13px;background:var(--p);color:#fff;border:none;border-radius:8px;font-size:15px;font-weight:700;cursor:pointer;margin-top:6px}
.btn-submit:hover{background:#163060}
.btn-submit:disabled{opacity:.5;cursor:not-allowed}
.msg{padding:12px 14px;border-radius:8px;font-size:13px;font-weight:600;margin-top:12px;display:none}
.msg.ok{background:#d1fae5;color:#065f46;display:block}
.msg.err{background:#fee2e2;color:#991b1b;display:block}

/* ── 사례 목록 ── */
.case-list{display:grid;gap:10px}
.case-item{background:var(--card);border:1px solid var(--bd);border-radius:12px;padding:14px;display:flex;gap:12px;align-items:flex-start;box-shadow:0 1px 3px rgba(0,0,0,.05)}
.case-thumb{width:64px;height:64px;border-radius:8px;background:#dde8f5;flex-shrink:0;overflow:hidden;display:flex;align-items:center;justify-content:center;font-size:24px}
.case-thumb img{width:100%;height:100%;object-fit:cover}
.case-info{flex:1;min-width:0}
.case-badge{display:inline-block;padding:2px 8px;background:#e8f0fb;color:var(--p);font-size:10px;font-weight:700;border-radius:4px;margin-bottom:5px}
.case-title{font-size:13.5px;font-weight:800;color:var(--tx);margin-bottom:3px;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.case-meta{font-size:11px;color:var(--mu)}
.case-actions{display:flex;gap:6px;margin-top:8px}
.btn-edit{padding:5px 12px;background:#e8f0fb;color:var(--p);border:none;border-radius:6px;font-size:12px;font-weight:700;cursor:pointer}
.btn-del{padding:5px 12px;background:#fee2e2;color:var(--a);border:none;border-radius:6px;font-size:12px;font-weight:700;cursor:pointer}
.btn-edit:hover{background:#d1e0f5}
.btn-del:hover{background:#fecaca}
.cases-toolbar{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px}
.cases-count{font-size:13px;color:var(--mu);font-weight:600}
.filter-sel{padding:7px 10px;border:1.5px solid var(--bd);border-radius:6px;font-size:12px;font-family:inherit;background:var(--card);outline:none}
.filter-sel:focus{border-color:var(--p)}

/* ── 수정 모달 ── */
.modal-bg{position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:999;display:none;align-items:center;justify-content:center;padding:20px}
.modal-bg.open{display:flex}
.modal{background:var(--card);border-radius:14px;width:100%;max-width:480px;max-height:90vh;overflow-y:auto;padding:24px 20px}
.modal h3{font-size:17px;font-weight:900;margin-bottom:20px}
.modal-btns{display:flex;gap:10px;margin-top:16px}
.btn-cancel{flex:1;padding:12px;background:var(--bg);color:var(--mu);border:1px solid var(--bd);border-radius:8px;font-size:14px;font-weight:700;cursor:pointer}

/* ── 빈 상태 ── */
.empty{text-align:center;padding:40px 20px;color:var(--mu);font-size:14px}
.loading{text-align:center;padding:30px 20px;color:var(--mu);font-size:14px}
  </style>
</head>
<body>

<div class="hd">
  <div class="hd-logo">스마트<b>디자인</b> 관리자</div>
  <a href="/" class="hd-home">← 사이트로</a>
</div>

<!-- 로그인 -->
<div id="login-screen">
  <div class="login-box">
    <h2>🔐 관리자 로그인</h2>
    <p>스마트디자인 관리자 전용 페이지입니다</p>
    <input type="password" id="pass-inp" class="inp" placeholder="비밀번호 입력" autocomplete="current-password"/>
    <button class="btn-primary" onclick="doLogin()">로그인</button>
    <div class="login-err" id="login-err">비밀번호가 올바르지 않습니다.</div>
  </div>
</div>

<!-- 관리 화면 -->
<div id="admin-screen">
  <div class="tabs">
    <div class="tab on" data-tab="add">➕ 사례 추가</div>
    <div class="tab" data-tab="list">📋 사례 관리</div>
  </div>

  <!-- 사례 추가 탭 -->
  <div class="tab-content on" id="tab-add">
    <div class="form-group">
      <label class="form-label">제목 *</label>
      <input type="text" class="form-inp" id="f-title" placeholder="예: 강동구 천호동 변기교체 완료"/>
    </div>
    <div class="form-row">
      <div class="form-group">
        <label class="form-label">지역 *</label>
        <input type="text" class="form-inp" id="f-loc" placeholder="예: 강동구 천호동"/>
      </div>
      <div class="form-group">
        <label class="form-label">서비스 *</label>
        <select class="form-sel" id="f-svc">
          <option value="">선택</option>
          <option>변기교체</option>
          <option>세면대수전교체</option>
          <option>싱크대수전교체</option>
          <option>샤워기수전교체</option>
          <option>환풍기교체</option>
          <option>전체인테리어</option>
          <option>바닥보수</option>
          <option>도배</option>
          <option>타일시공</option>
          <option>누수수리</option>
        </select>
      </div>
    </div>
    <div class="form-group">
      <label class="form-label">날짜 *</label>
      <input type="date" class="form-inp" id="f-date"/>
    </div>
    <div class="form-group">
      <label class="form-label">시공 내용 *</label>
      <textarea class="form-ta" id="f-desc" placeholder="시공 내용을 간략히 입력하세요."></textarea>
    </div>
    <div class="form-group">
      <label class="form-label">이미지 URL (선택)</label>
      <input type="url" class="form-inp" id="f-img" placeholder="https://..."/>
    </div>
    <div class="form-group">
      <label class="form-label">태그 (쉼표 구분, 선택)</label>
      <input type="text" class="form-inp" id="f-tags" placeholder="변기교체, 강동구, 당일출장"/>
    </div>
    <button class="btn-submit" id="submit-btn" onclick="submitCase()">📤 게시하기</button>
    <div class="msg" id="submit-msg"></div>
  </div>

  <!-- 사례 관리 탭 -->
  <div class="tab-content" id="tab-list">
    <div class="cases-toolbar">
      <span class="cases-count" id="cases-count">불러오는 중...</span>
      <select class="filter-sel" id="filter-svc" onchange="filterCases()">
        <option value="">전체 서비스</option>
        <option>변기교체</option>
        <option>세면대수전교체</option>
        <option>싱크대수전교체</option>
        <option>샤워기수전교체</option>
        <option>환풍기교체</option>
        <option>전체인테리어</option>
        <option>바닥보수</option>
        <option>도배</option>
        <option>타일시공</option>
        <option>누수수리</option>
      </select>
    </div>
    <div class="case-list" id="case-list"><div class="loading">⏳ 불러오는 중...</div></div>
  </div>
</div>

<!-- 수정 모달 -->
<div class="modal-bg" id="edit-modal">
  <div class="modal">
    <h3>✏️ 사례 수정</h3>
    <input type="hidden" id="e-id"/>
    <div class="form-group"><label class="form-label">제목</label><input type="text" class="form-inp" id="e-title"/></div>
    <div class="form-row">
      <div class="form-group"><label class="form-label">지역</label><input type="text" class="form-inp" id="e-loc"/></div>
      <div class="form-group"><label class="form-label">서비스</label>
        <select class="form-sel" id="e-svc">
          <option>변기교체</option><option>세면대수전교체</option><option>싱크대수전교체</option>
          <option>샤워기수전교체</option><option>환풍기교체</option><option>전체인테리어</option>
          <option>바닥보수</option><option>도배</option><option>타일시공</option><option>누수수리</option>
        </select>
      </div>
    </div>
    <div class="form-group"><label class="form-label">날짜</label><input type="date" class="form-inp" id="e-date"/></div>
    <div class="form-group"><label class="form-label">시공 내용</label><textarea class="form-ta" id="e-desc"></textarea></div>
    <div class="form-group"><label class="form-label">이미지 URL</label><input type="url" class="form-inp" id="e-img"/></div>
    <div class="form-group"><label class="form-label">태그 (쉼표 구분)</label><input type="text" class="form-inp" id="e-tags"/></div>
    <div class="modal-btns">
      <button class="btn-cancel" onclick="closeModal()">취소</button>
      <button class="btn-submit" style="flex:2" onclick="saveEdit()">💾 저장</button>
    </div>
    <div class="msg" id="edit-msg"></div>
  </div>
</div>

<script>
var PASS = '';
var allCases = [];
var svcIcon = {'변기교체':'🚽','세면대수전교체':'🪣','싱크대수전교체':'🍳','샤워기수전교체':'🚿','환풍기교체':'💨','전체인테리어':'🏠','바닥보수':'🪵','도배':'🖼️','타일시공':'🔲','누수수리':'💧'};

/* ── 로그인 ── */
document.getElementById('pass-inp').addEventListener('keydown', function(e){if(e.key==='Enter') doLogin()});
function doLogin(){
  var v = document.getElementById('pass-inp').value.trim();
  if(!v){return;}
  PASS = v;
  // 간단한 클라이언트 체크 (실제 검증은 서버에서)
  document.getElementById('login-screen').style.display = 'none';
  document.getElementById('admin-screen').style.display = 'block';
  // 기본 날짜 설정
  document.getElementById('f-date').value = new Date().toISOString().slice(0,10);
  loadCases();
}

/* ── 탭 전환 ── */
document.querySelectorAll('.tab').forEach(function(t){
  t.addEventListener('click', function(){
    document.querySelectorAll('.tab').forEach(function(x){x.classList.remove('on')});
    document.querySelectorAll('.tab-content').forEach(function(x){x.classList.remove('on')});
    this.classList.add('on');
    document.getElementById('tab-'+this.dataset.tab).classList.add('on');
    if(this.dataset.tab === 'list') loadCases();
  });
});

/* ── 사례 목록 로드 ── */
function loadCases(){
  fetch('/data/cases.json?t='+Date.now())
    .then(function(r){return r.json()})
    .then(function(d){
      allCases = d;
      filterCases();
    })
    .catch(function(){
      document.getElementById('case-list').innerHTML = '<div class="empty">사례를 불러올 수 없습니다.</div>';
      document.getElementById('cases-count').textContent = '0개';
    });
}

function filterCases(){
  var f = document.getElementById('filter-svc').value;
  var list = f ? allCases.filter(function(c){return c.service === f}) : allCases;
  document.getElementById('cases-count').textContent = '총 '+list.length+'개';
  var el = document.getElementById('case-list');
  if(!list.length){el.innerHTML='<div class="empty">등록된 사례가 없습니다.</div>';return;}
  el.innerHTML = list.map(function(c){
    var ic = svcIcon[c.service]||'🔧';
    var thumb = c.image
      ? '<div class="case-thumb"><img src="'+c.image+'" alt="" onerror="this.style.display=\'none\'"></div>'
      : '<div class="case-thumb">'+ic+'</div>';
    return '<div class="case-item" data-id="'+c.id+'">'
      + thumb
      + '<div class="case-info">'
      + '<span class="case-badge">'+c.service+'</span>'
      + '<div class="case-title">'+c.title+'</div>'
      + '<div class="case-meta">📍 '+c.location+' · '+c.date+'</div>'
      + '<div class="case-actions">'
      + '<button class="btn-edit" onclick="openEdit(\''+c.id+'\')">✏️ 수정</button>'
      + '<button class="btn-del" onclick="delCase(\''+c.id+'\',\''+c.title.replace(/'/g,'')+"')\"" + '>🗑️ 삭제</button>'
      + '</div></div></div>';
  }).join('');
}

/* ── 사례 추가 ── */
function submitCase(){
  var title=document.getElementById('f-title').value.trim();
  var loc  =document.getElementById('f-loc').value.trim();
  var svc  =document.getElementById('f-svc').value;
  var date =document.getElementById('f-date').value;
  var desc =document.getElementById('f-desc').value.trim();
  var img  =document.getElementById('f-img').value.trim();
  var tags =document.getElementById('f-tags').value.trim();

  if(!title||!loc||!svc||!date||!desc){showMsg('submit-msg','err','필수 항목을 모두 입력해주세요.');return;}

  var btn = document.getElementById('submit-btn');
  btn.disabled = true; btn.textContent = '⏳ 저장 중...';

  var body = {
    password:PASS, title:title, location:loc, service:svc,
    date:date, description:desc, image:img||'',
    tags:tags?tags.split(',').map(function(t){return t.trim()}).filter(Boolean):[]
  };

  fetch('/.netlify/functions/add-case', {
    method:'POST',
    headers:{'Content-Type':'application/json'},
    body:JSON.stringify(body)
  })
  .then(function(r){return r.json().then(function(d){return{ok:r.ok,d:d}})})
  .then(function(res){
    if(res.ok){
      showMsg('submit-msg','ok','✅ 게시 완료! 잠시 후 사이트에 반영됩니다.');
      ['f-title','f-loc','f-desc','f-img','f-tags'].forEach(function(id){document.getElementById(id).value=''});
      document.getElementById('f-svc').value='';
      document.getElementById('f-date').value=new Date().toISOString().slice(0,10);
    } else {
      showMsg('submit-msg','err','❌ 오류: '+(res.d.message||'저장 실패'));
    }
  })
  .catch(function(e){showMsg('submit-msg','err','❌ 네트워크 오류: '+e.message)})
  .finally(function(){btn.disabled=false;btn.textContent='📤 게시하기'});
}

/* ── 수정 모달 ── */
function openEdit(id){
  var c = allCases.find(function(x){return x.id===id});
  if(!c) return;
  document.getElementById('e-id').value   = c.id;
  document.getElementById('e-title').value= c.title;
  document.getElementById('e-loc').value  = c.location;
  document.getElementById('e-svc').value  = c.service;
  document.getElementById('e-date').value = c.date;
  document.getElementById('e-desc').value = c.description;
  document.getElementById('e-img').value  = c.image||'';
  document.getElementById('e-tags').value = (c.tags||[]).join(', ');
  document.getElementById('edit-msg').className='msg';
  document.getElementById('edit-msg').style.display='none';
  document.getElementById('edit-modal').classList.add('open');
}
function closeModal(){document.getElementById('edit-modal').classList.remove('open')}

function saveEdit(){
  var id    = document.getElementById('e-id').value;
  var title = document.getElementById('e-title').value.trim();
  var loc   = document.getElementById('e-loc').value.trim();
  var svc   = document.getElementById('e-svc').value;
  var date  = document.getElementById('e-date').value;
  var desc  = document.getElementById('e-desc').value.trim();
  var img   = document.getElementById('e-img').value.trim();
  var tags  = document.getElementById('e-tags').value.trim();
  if(!title||!loc||!desc){showMsg('edit-msg','err','필수 항목을 입력해주세요.');return;}

  fetch('/.netlify/functions/add-case', {
    method:'POST',
    headers:{'Content-Type':'application/json'},
    body:JSON.stringify({
      password:PASS, action:'update', id:id,
      title:title, location:loc, service:svc, date:date,
      description:desc, image:img||'',
      tags:tags?tags.split(',').map(function(t){return t.trim()}).filter(Boolean):[]
    })
  })
  .then(function(r){return r.json().then(function(d){return{ok:r.ok,d:d}})})
  .then(function(res){
    if(res.ok){
      showMsg('edit-msg','ok','✅ 수정 완료!');
      setTimeout(function(){closeModal();loadCases()},1200);
    } else {
      showMsg('edit-msg','err','❌ 오류: '+(res.d.message||'수정 실패'));
    }
  })
  .catch(function(e){showMsg('edit-msg','err','❌ 네트워크 오류')});
}

/* ── 삭제 ── */
function delCase(id, title){
  if(!confirm('"'+title+'" 사례를 삭제하시겠습니까?')) return;
  fetch('/.netlify/functions/add-case', {
    method:'POST',
    headers:{'Content-Type':'application/json'},
    body:JSON.stringify({password:PASS, action:'delete', id:id})
  })
  .then(function(r){return r.json().then(function(d){return{ok:r.ok,d:d}})})
  .then(function(res){
    if(res.ok){loadCases();}
    else alert('삭제 실패: '+(res.d.message||'오류'));
  })
  .catch(function(){alert('네트워크 오류')});
}

function showMsg(id,type,text){
  var el=document.getElementById(id);
  el.className='msg '+type;
  el.textContent=text;
  el.style.display='block';
  if(type==='ok') setTimeout(function(){el.style.display='none'},4000);
}
</script>
</body>
</html>
